# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TMDB_API_KEY & TMDB_READ_TOKEN: The Movie Database credentials for server-side catalog proxy.
TMDB_API_KEY="MY_TMDB_API_KEY"
TMDB_READ_TOKEN="MY_TMDB_READ_TOKEN"

# ADMIN_ACCESS_CODE: Secret passkey for unlocking the XEROTV Admin Dashboard.
ADMIN_ACCESS_CODE="MY_ADMIN_ACCESS_CODE"
